# Database Configuration
DATABASE_URL=postgresql://postgres:password@db:5432/tutor_system

# Supabase Configuration (Optional)
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# External Services URLs
HCMUT_SSO_URL=http://mock-sso:3001
HCMUT_DATACORE_URL=http://mock-datacore:3002
HCMUT_LIBRARY_URL=http://mock-library:3003

# Redis Configuration
REDIS_URL=redis://redis:6379

# Security
BCRYPT_ROUNDS=12

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=HCMUT Tutor Support System