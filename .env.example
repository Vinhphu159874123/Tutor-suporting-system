# Database
DATABASE_URL=postgresql://postgres:password@db:5432/tutor_system

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# JWT
JWT_SECRET_KEY=your_super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# HCMUT SSO
HCMUT_SSO_URL=http://mock-sso:3001
HCMUT_SSO_CLIENT_ID=your_client_id
HCMUT_SSO_CLIENT_SECRET=your_client_secret

# HCMUT DataCore
HCMUT_DATACORE_URL=http://mock-datacore:3002

# HCMUT Library
HCMUT_LIBRARY_URL=http://mock-library:3003

# Redis
REDIS_URL=redis://redis:6379

# Frontend
REACT_APP_API_URL=http://localhost:8000
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_anon_key_here

# Development
DEBUG=True
ENVIRONMENT=development
