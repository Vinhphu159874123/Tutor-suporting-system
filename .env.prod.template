# Production Environment Variables Template
# Copy this file to .env.prod and fill in the actual values

# Database Configuration (Supabase or your PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# JWT Configuration
JWT_SECRET_KEY=your_very_secure_random_secret_key_here_change_this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# HCMUT Services
# For production, use real HCMUT service URLs
HCMUT_SSO_URL=https://sso.hcmut.edu.vn
HCMUT_DATACORE_URL=https://datacore.hcmut.edu.vn
HCMUT_LIBRARY_URL=https://library.hcmut.edu.vn

# OR use mock services for testing
# HCMUT_SSO_URL=http://mock-sso:3001
# HCMUT_DATACORE_URL=http://mock-datacore:3002
# HCMUT_LIBRARY_URL=http://mock-library:3003

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000

# Application Environment
ENVIRONMENT=production
DEBUG=false

# Redis Configuration (if needed)
REDIS_URL=redis://redis:6379/0

# Security
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,https://yourdomain.com
CORS_ALLOW_CREDENTIALS=true

# Logging
LOG_LEVEL=info

# Email Configuration (if you add email features later)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-app-password
